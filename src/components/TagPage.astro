---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { prefix, tagsUrl, ui, type Lang } from '../i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  name: string;
  posts: CollectionEntry<'posts'>[];
}
const { lang, name, posts } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} title={t.taggedWith(name)}>
  <header class="tag-header">
    <h1 class="page-title">{name}</h1>
    <p class="page-meta">
      <span>{t.postCount(posts.length)}</span>
      <a href={`${prefix(lang)}/`}>{t.allPosts}</a>
      <a href={tagsUrl(lang)}>{t.allTags}</a>
    </p>
  </header>
  <PostList posts={posts} lang={lang} />
</Base>
