---
import type { CollectionEntry } from 'astro:content';
import { SITE, postUrl, slugOf, ui, type Lang } from '../i18n';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = ui[lang];
const url = new URL(postUrl(post), Astro.site).href;
const year = post.data.date.getUTCFullYear();
const key = `${SITE.authorBibtex.split(',')[0].toLowerCase()}${year}${slugOf(post).replace(/[^\w-]/g, '')}`;
// Titles are plain text, so LaTeX's special characters are escaped (one pass,
// so the braces it adds are not escaped again).
const TEX: Record<string, string> = { '\\': '\\textbackslash{}', '~': '\\textasciitilde{}', '^': '\\textasciicircum{}' };
const tex = (s: string) => s.replace(/[\\&%#_${}~^]/g, (c) => TEX[c] ?? `\\${c}`);
// Double braces keep BibTeX from changing the title's case.
const bibtex = `@misc{${key},
  author = {${SITE.authorBibtex}},
  title  = {{${tex(post.data.title)}}},
  year   = {${year}},
  url    = {${url}},
  note   = {${lang === 'zh' ? '博客文章' : 'Blog post'}},
}`;
---

<!-- The same title, URL and BibTeX on every post: not for site search. -->
<section class="cite-this" aria-labelledby="cite-this" data-pagefind-ignore>
  <h2 id="cite-this">{t.citeThis}</h2>
  <p>{SITE.author}. {post.data.title}. {year}. <a href={url}>{url}</a></p>
  <div class="cite-bibtex">
    <pre><code>{bibtex}</code></pre>
    <button class="copy-button" type="button" aria-live="polite">{t.copy}</button>
  </div>
</section>

