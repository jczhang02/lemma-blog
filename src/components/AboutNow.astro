---
// The about page's now block: what the owner is doing, then the place and its
// local time. The time and UTC offset are written in the browser, since a
// time set at build would be stale; the build writes the offset as a fallback.
import { utcOffset } from '../scripts/dates';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  text: string;
  updated?: string;
  place?: string;
  /** An IANA time zone (checked by the content schema). */
  timezone?: string;
}
const { lang, text, updated, place, timezone } = Astro.props;
const t = ui[lang];
---

<div class="now" data-tz={place && timezone}>
  <p class="now-text">
    <span class="now-label">
      {t.now}
      {updated && ` · ${updated}`}
    </span>
    {text}
  </p>
  {
    place && (
      <p class="now-place">
        <span>{place}</span>
        {timezone && (
          <>
            <time class="now-clock" />
            <span>
              {t.localTime} (<span class="now-offset">{utcOffset(timezone)}</span>)
            </span>
          </>
        )}
      </p>
    )
  }
</div>

<script>
  import { utcOffset } from '../scripts/dates';

  const places = document.querySelectorAll<HTMLElement>('.now[data-tz]');
  const tick = () => {
    for (const place of places) {
      const timeZone = place.dataset.tz!;
      place.querySelector('.now-clock')!.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone }).format(new Date());
      place.querySelector('.now-offset')!.textContent = utcOffset(timeZone) ?? '';
    }
  };
  if (places.length) {
    tick();
    setInterval(tick, 15000);
  }
</script>
