---
import Base from '../layouts/Base.astro';
import TagLine from './TagLine.astro';
import { getTags, otherLang, prefix, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const tags = await getTags(lang);
---

<Base lang={lang} title={t.tags} alternate={`${prefix(otherLang(lang))}/tags/`}>
  <h1 class="page-title">{t.tags}</h1>
  {tags.length === 0 ? <p class="empty">{t.noPosts}</p> : <TagLine lang={lang} />}
</Base>
