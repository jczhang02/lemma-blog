---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, ui, type Lang } from '../i18n';

interface Props {
  posts: CollectionEntry<'posts'>[];
  lang: Lang;
}
const { posts, lang } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{ui[lang].noPosts}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={postUrl(post)}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
            <span class="post-title">{post.data.title}</span>
            {post.data.description && <span class="post-desc">{post.data.description}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}
