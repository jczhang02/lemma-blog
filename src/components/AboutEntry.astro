---
// One entry of the about page: the date in the left column, then the title
// (a link when it has one), what the slot holds (subtitle, authors, note), and
// a link row of `links` followed by the `links` slot. hrefs are final URLs.
interface Props {
  when?: string;
  /** An ISO date for `when`, which is then a <time>. */
  datetime?: string;
  title: string;
  href?: string;
  links?: { label: string; href: string }[];
}
const { when, datetime, title, href, links = [] } = Astro.props;
// The slot may hold nothing (its items are conditional): then no row for it.
const extra = Astro.slots.has('links') ? (await Astro.slots.render('links')).trim() : '';
---

<li class="entry">
  {when && (datetime ? <time class="entry-when" datetime={datetime}>{when}</time> : <span class="entry-when">{when}</span>)}
  <div class="entry-body">
    <p class="entry-title">{href ? <a href={href}>{title}</a> : title}</p>
    <slot />
    {
      (links.length > 0 || extra) && (
        <ul class="link-row">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
          <Fragment set:html={extra} />
        </ul>
      )
    }
  </div>
</li>
