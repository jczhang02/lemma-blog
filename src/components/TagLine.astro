---
// The tags of one language in a single flowing line, each with its post count,
// most used first. Past LIMIT tags the line keeps the most used and ends with
// a link to the tags page, so it does not push the posts down the page.
import { getTags, tagUrl, tagsUrl, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
// About two lines in the column.
const LIMIT = 12;
const tags = await getTags(lang);
const shown = tags.length > LIMIT ? tags.slice(0, LIMIT) : tags;
---

{
  tags.length > 0 && (
    <nav class="tag-line" aria-label={t.tags}>
      <ul>
        {shown.map((tag) => (
          <li>
            <a href={tagUrl(lang, tag.name)}>
              {tag.name}
              <span class="tag-count">{tag.posts.length}</span>
            </a>
          </li>
        ))}
        {shown.length < tags.length && (
          <li class="tag-all">
            <a href={tagsUrl(lang)}>{t.allTagsCount(tags.length)} →</a>
          </li>
        )}
      </ul>
    </nav>
  )
}
