---
// Minimap-style table of contents (after Notion / ChatGPT / chanhdai's TOC
// Minimap): one tick per heading in the left margin; hovering or focusing
// opens a panel with the titles. Wide screens only.
interface Props {
  toc: { depth: number; slug: string; html: string }[];
  label: string;
}
const { toc, label } = Astro.props;
---

{
  toc.length >= 2 && (
    <nav class="toc" aria-label={label}>
      <ol class="toc-ticks" aria-hidden="true">
        {toc.map((h) => (
          <li data-depth={h.depth} data-slug={h.slug} />
        ))}
      </ol>
      <div class="toc-panel">
        <ol>
          {toc.map((h) => (
            <li data-depth={h.depth} data-slug={h.slug}>
              <a href={`#${h.slug}`} set:html={h.html} />
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<script>
  // Highlight the last heading that has scrolled past the top fifth of the viewport.
  const nav = document.querySelector<HTMLElement>('.toc');
  if (nav) {
    const items = [...nav.querySelectorAll<HTMLElement>('.toc-ticks li, .toc-panel li')];
    const headings = [...new Set(items.map((li) => li.dataset.slug!))]
      .map((slug) => document.getElementById(slug))
      .filter((h): h is HTMLElement => h !== null);
    let active: string | undefined;
    let queued = false;
    const update = () => {
      queued = false;
      const line = innerHeight / 5;
      const current = headings.filter((h) => h.getBoundingClientRect().top < line).at(-1) ?? headings[0];
      if (current?.id === active) return;
      active = current?.id;
      for (const li of items) li.toggleAttribute('data-active', li.dataset.slug === active);
    };
    addEventListener('scroll', () => queued || ((queued = true), requestAnimationFrame(update)), { passive: true });
    // Long lists scroll inside the panel; open it at the current section.
    nav.addEventListener('mouseenter', () =>
      nav.querySelector('.toc-panel li[data-active]')?.scrollIntoView({ block: 'nearest' }),
    );
    update();
  }
</script>

<style>
  .toc {
    display: none;
  }

  @media (min-width: 72rem) {
    .toc {
      display: block;
      position: fixed;
      top: 50%;
      left: max(1.5rem, calc(50vw - var(--measure) / 2 - 9rem));
      transform: translateY(-50%);
      z-index: 10;
      font-family: var(--font-sans);
    }
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Ticks: 2px bars, shorter for deeper headings. */
  .toc-ticks {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-height: 60vh;
    overflow: hidden;
    padding: 0.5rem 0;
  }

  /* Full length is the active state; others are scaled down (20px, 12px). */
  .toc-ticks li {
    width: 1.75rem;
    height: 2px;
    border-radius: 1px;
    background: var(--rule);
    transform: scaleX(0.714);
    transform-origin: left;
    transition: background-color 0.2s, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toc-ticks li[data-depth='3'] {
    transform: scaleX(0.429);
  }

  .toc-ticks li[data-active] {
    background: var(--text);
    transform: none;
  }

  /* Panel: opens to the right of the ticks. The left padding is a hover
     bridge, so the pointer can cross the gap without closing it. */
  .toc-panel {
    position: absolute;
    top: 50%;
    left: 100%;
    padding-left: 0.875rem;
    /* Hidden with opacity, not visibility, so the links stay focusable and
       keyboard focus can open the panel through :focus-within. */
    opacity: 0;
    pointer-events: none;
    filter: blur(4px);
    transform: translate(-0.375rem, -50%) scale(0.98);
    transform-origin: left center;
    /* Closing waits a beat, so a pointer that slips off briefly does not flicker it. */
    transition:
      opacity 0.12s ease-in 0.08s,
      transform 0.12s ease-in 0.08s,
      filter 0.12s ease-in 0.08s;
  }

  .toc:hover .toc-panel,
  .toc:focus-within .toc-panel {
    opacity: 1;
    pointer-events: auto;
    filter: none;
    transform: translate(0, -50%);
    transition:
      opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toc-panel ol {
    width: max-content;
    min-width: 12rem;
    max-width: 18rem;
    max-height: 60vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.375rem;
    border-radius: 14px;
    background: var(--raised);
    box-shadow: var(--shadow-raised);
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
  }

  .toc-panel a {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    padding: 0.4375rem 0.75rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  /* Subsections: indented, one step smaller. */
  .toc-panel li[data-depth='3'] a {
    padding-left: 1.625rem;
    font-size: 0.8125rem;
  }

  /* Ink at low alpha, so the fill reads on the raised surface in both themes. */
  .toc-panel a:hover {
    background: color-mix(in srgb, var(--text) 6%, transparent);
    color: var(--text);
  }

  .toc-panel a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* Current section: ink and weight, distinct from the hover fill. */
  .toc-panel li[data-active] a {
    color: var(--text);
    font-weight: 550;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-panel,
    .toc:hover .toc-panel,
    .toc:focus-within .toc-panel {
      filter: none;
      transform: translate(0, -50%);
      transition: opacity 0.12s;
    }
  }
</style>
