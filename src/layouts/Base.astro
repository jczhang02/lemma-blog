---
// Fonts and design tokens (colors, font stacks, layout) come from
// lemma.config.mjs through plugins/lemma-theme.mjs.
import 'virtual:lemma/fonts';
import 'virtual:lemma/tokens.css';
import '../styles/mathjax.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import lemma from '../../lemma.config.mjs';
import { SITE, ui, prefix, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** URL of this page in the other language, if one exists. */
  alternate?: string;
  /** Publication date, for posts (Open Graph type "article"). */
  published?: Date;
}

const { lang, title, description = ui[lang].description, alternate, published } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const other = otherLang(lang);
const switchTo = alternate ?? `${prefix(other)}/`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The avatar named in the config, as an optimizable image.
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const avatar = images[`/${lemma.site.avatar}`]?.default;
if (!avatar) throw new Error(`lemma.config.mjs: site.avatar ${lemma.site.avatar} is not an image under src/assets/`);
const { icons } = lemma.site;
const locale = { zh: 'zh_CN', en: 'en_US' };
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(icons.png192, Astro.site).href} />
    <meta property="og:locale" content={locale[lang]} />
    {alternate && <meta property="og:locale:alternate" content={locale[other]} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={icons.favicon} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href={icons.png192} sizes="192x192" />
    <link rel="apple-touch-icon" href={icons.appleTouch} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${prefix(lang)}/rss.xml`} />
    {alternate && <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonical} />}
    {alternate && <link rel="alternate" hreflang={other === 'zh' ? 'zh-CN' : 'en'} href={new URL(alternate, Astro.site).href} />}
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Runs before paint, so the page never flashes the wrong theme.
      (() => {
        // Storage can be blocked (privacy settings); then follow the OS.
        const stored = () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        };
        const media = matchMedia('(prefers-color-scheme: dark)');
        const apply = (dark) => (document.documentElement.dataset.theme = dark ? 'dark' : 'light');
        const theme = stored();
        apply(theme ? theme === 'dark' : media.matches);
        media.addEventListener('change', (e) => !stored() && apply(e.matches));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <header class="site-header">
      <a class="wordmark" href={`${prefix(lang)}/`}>
        <Image class="wordmark-avatar" src={avatar} alt="" width={32} height={32} layout="none" densities={[1, 2, 3]} loading="eager" />
        {SITE.title}
      </a>
      <nav>
        <a href={`${prefix(lang)}/`}>{t.posts}</a>
        <a href={switchTo} hreflang={other} lang={other}>{other === 'en' ? 'EN' : '中'}</a>
        <button class="theme-toggle" type="button" aria-label={t.toggleTheme} title={t.toggleTheme}>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
        </button>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {SITE.title}</span>
      <nav class="footer-links" aria-label={t.links}>
        <a href={`mailto:${SITE.email}`}>{t.email}</a>
        <a href={`https://github.com/${SITE.github}`}>GitHub</a>
        <a href={`${prefix(lang)}/rss.xml`}>{t.rss}</a>
      </nav>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const pressed = () => toggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      pressed();
      // The theme also follows the OS (head script), so watch the attribute itself.
      new MutationObserver(pressed).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
