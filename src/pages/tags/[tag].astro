---
import TagPage from '../../components/TagPage.astro';
import { getTags } from '../../i18n';

export async function getStaticPaths() {
  const tags = await getTags('zh');
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: tag }));
}
---

<TagPage lang="zh" name={Astro.props.name} posts={Astro.props.posts} />
