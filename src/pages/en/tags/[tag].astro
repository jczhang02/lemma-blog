---
import TagPage from '../../../components/TagPage.astro';
import { getTags } from '../../../i18n';

export async function getStaticPaths() {
  const tags = await getTags('en');
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: tag }));
}
---

<TagPage lang="en" name={Astro.props.name} posts={Astro.props.posts} />
