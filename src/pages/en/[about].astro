---
import AboutPage from '../../components/AboutPage.astro';
import { hasAbout } from '../../i18n';

// /en/about/, built only when src/content/about/en.md exists.
export async function getStaticPaths() {
  return (await hasAbout('en')) ? [{ params: { about: 'about' } }] : [];
}
---

<AboutPage lang="en" />
