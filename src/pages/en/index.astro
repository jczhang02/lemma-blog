---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import TagLine from '../../components/TagLine.astro';
import TaglineCurve from '../../components/TaglineCurve.astro';
import { SITE, getPosts, ui } from '../../i18n';
import { formula } from 'virtual:lemma/math';

const lang = 'en';
const posts = await getPosts(lang);
---

<Base lang={lang} alternate="/">
  <h1 class="sr-only">{SITE.title}</h1>
  <section class="intro">
    {SITE.introCurve && <TaglineCurve curve={SITE.introCurve} />}
    {formula ? <p class="intro-formula" set:html={formula} /> : <p>{ui[lang].description}</p>}
  </section>
  <TagLine lang={lang} />
  <PostList posts={posts} lang={lang} />
</Base>
