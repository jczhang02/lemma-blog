---
import AboutPage from '../components/AboutPage.astro';
import { hasAbout } from '../i18n';

// /about/, built only when src/content/about/zh.md exists.
export async function getStaticPaths() {
  return (await hasAbout('zh')) ? [{ params: { about: 'about' } }] : [];
}
---

<AboutPage lang="zh" />
