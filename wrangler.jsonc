{
  // The site on Cloudflare Workers as static assets only (no Worker code):
  // asset requests are free, unlimited, and never billed. Deploy with
  // `bun run deploy` (scripts/deploy.mjs).
  "name": "jczhang-blog",
  "account_id": "7087de4e3396c29d639ba6c4919c0e29",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "jczhang.cc", "custom_domain": true }],
  // No *.workers.dev copy of the site; it lives at jczhang.cc only.
  "workers_dev": false,
  "preview_urls": false
}
